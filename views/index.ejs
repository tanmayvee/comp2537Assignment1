<%- include('templates/header') %>

<% if (loggedIn) { %>
    <div class="text-center mt-5">
        <h1 class="display-4">Hello, <%= name %>!</h1>
        <p class="lead" style="color:#c9ab20;">Welcome back.</p>
        <a href="/members" class="btn btn-primary mt-3 me-2">Go to Members Area</a>
        <a href="/logout" class="btn btn-outline-secondary mt-3">Logout</a>
    </div>
<% } else { %>
    <div class="text-center mt-5">
        <h1 class="display-4">Welcome</h1>
        <p class="lead text-muted">Please sign up or log in to continue.</p>
        <a href="/signup" class="btn btn-primary mt-3 me-2">Sign Up</a>
        <a href="/login" class="btn btn-gold mt-3">Log In</a>
    </div>
<% } %>

<%- include('templates/footer') %>
